# ============ 密钥与环境（绝不入库） ============
.env

# ============ 虚拟环境 / 缓存 ============
.venv/
__pycache__/
*.pyc
.uv-cache/
.hf-cache/
.idea/

# ============ 运行时数据（可再生的本地产物，不入库） ============
data/
logs/
content/plans/
content/raw/
# 删除的模板软删到这里（带时间戳，可手工找回）——是老师的数据，不入库
content/templates/_trash/
model_cache/

# ============ 教材知识库说明 ============
# chroma_db/ 与 content/structured_auto/ 已入库：
# content/structured_auto/*.md = 教材自动切节文本（向量化源）
# chroma_db/ = 预建向量库（151 块，可直接检索；也可按 README 重建）

# ============ 前端备份文件（不入库） ============
static/*.bak-*
*.bak-*

# ============ 第三方 WPS MCP（wps-skills）：绝不入库 ============
# 交接约定见 docs/09-WPS接入交接要求.md：第三方源码/node_modules 会让仓库爆掉，
# 一律由 deploy/setup_wps_mcp.cmd 克隆到仓库外（默认 %LOCALAPPDATA%\edu-agent\deps\wps-skills），
# 应用侧按 WPS_MCP_DIR / data/wps_mcp.json 解析路径。下面两行是防回流护栏，别删。
mcp_servers/wps-office-mcp/
skills/

# ============ 演示模板库（content/ppt_templates/）============
# 仓库只留内置 3 套**数值**（_builtin/*.json）；导入的学校/老师 .pptx 原稿是用户资产，不入库
# （见 docs/19 §9.1：原稿只读、软删进 _trash/）。index.json 是派生清单，也不入库。
# _design/ 是 R27a 的**设计规格注册表**（由 tools/compile_design_registry.py 从两份 skill 编译而来）：
# 它是**自包含**的（两份 skill 不在场也能跑，docs/29 §1.2 红线），所以要入库。
content/ppt_templates/*
!content/ppt_templates/_builtin/
!content/ppt_templates/_design/

# wiki 有自己的独立本地 git 仓库（教材派生内容不入 public 远端）
content/wiki/
# UI 检查脚本的依赖（按需 npm i jsdom，不入库）
tools/uicheck/node_modules/
tools/uicheck/package-lock.json

# 第三方依赖（ppt-master / wps-skills）：装项目内但不入库（2026-09-25 从 C 盘迁入）
.deps/

# 构建缓存（uv / pip）：迁到项目盘，避免占 C 盘
.cache/

# 模块3 测试临时目录（仓库内建，避免沙箱对系统 %TEMP% 的限制）
.tmp-skill-market/
.tmp-probe/
