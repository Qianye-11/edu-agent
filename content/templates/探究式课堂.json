            [{"text": "授课班级", "b": true, "align": "center"}, {"text": "待填写", "b": false, "align": ""}, {"text": "授课教师", "b": true, "align": "center"}, {"text": "待填写", "b": false, "align": ""}]
          ]
        }
      ]
