# ============================================================
# edu-agent 环境配置样例 —— 复制为 .env 后填入真实值
#   Windows:  copy .env.example .env
#   Linux/Mac: cp .env.example .env
# ============================================================

# ---------- LLM：DeepSeek（必填） ----------
DEEPSEEK_API_KEY=replace-me-here

# ---------- Embedding：默认本机 Ollama bge-m3（免 key） ----------
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3

# ---------- LLM 服务参数（默认已可用） ----------
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# ---------- 图片 / 公式视觉理解（可选；默认复用上面的 DeepSeek Key 与地址） ----------
# 官方 DeepSeek Flash 支持 JPEG/PNG/GIF/WebP 多模态输入。
VISION_MODEL=deepseek-flash
# VISION_API_KEY=                  # 留空时复用 DEEPSEEK_API_KEY
# VISION_BASE_URL=https://api.deepseek.com/v1
VISION_MAX_BYTES=8388608
VISION_TIMEOUT=120

# 备用远程通道（可选）：硅基流动 bge-m3
SILICONFLOW_API_KEY=replace-me-here

# ---------- 内容与知识库（默认相对项目根，可不动） ----------
# CHROMA_DB_DIR=chroma_db
# CONTENT_DIR=content/structured
# AUTO_CONTENT_DIR=content/structured_auto
# TEXTBOOK_PDF=            # 可选：教材源 PDF 绝对路径（重新切节/重建向量库时才需要）

# ---------- 运行时数据根（可选整体外移） ----------
# EDU_DATA_DIR=data
# EDU_SESSIONS_DB=data/edu_sessions.db
# EDU_LOG_FILE=data/logs/edu_agent.log

# ---------- 上传防护（可选） ----------
# 单个 PDF / DOCX 的最大体积（默认 25 MB）与 PDF 最大页数（默认 300）
# EDU_UPLOAD_MAX_BYTES=26214400
# EDU_UPLOAD_MAX_PDF_PAGES=300

# ---------- rerank（默认关闭；内存紧张勿开） ----------
# RERANK_ON=0
# RERANK_PROVIDER=local
# RERANK_MODEL_DIR=./model_cache/bge-reranker-v2-m3

# ---------- 「新建项目 / 文件浏览」的默认根目录（可选） ----------
# 不填时默认 = 用户主目录下的 hermes（如 C:\Users\你的名字\hermes）
# 想指定成别的目录（例如 D:\hermes）就打开下面这行
# EDU_FS_ROOT=D:\hermes

# ============ Skill Studio（doc 34 §7.1）：教师 Skill 自动发现 / 审查 / 团队共享 ============
# 候选检测与草稿生成（本地，可离线）
SKILL_STUDIO_ENABLED=1
# 目录：默认沿用已有实现 <data_dir>/skill_market（历史数据都在那，别改）。
# 想按 doc 34 的命名换成 data/skill_studio，就打开下面这行 —— 注意：换了目录 =
# 市场四区/候选/审计整体搬家，旧数据不会自动迁移（要迁移就先手动拷贝目录）。
# SKILL_STUDIO_DIR=data/skill_studio
SKILL_CANDIDATE_WINDOW_DAYS=30
SKILL_CANDIDATE_MIN_SESSIONS=3
SKILL_CANDIDATE_COOLDOWN_DAYS=30
SKILL_STUDIO_EXTRACTION_PROVIDER=local
# L3 影子运行是否真跑插件：1=跑（默认，验证更强）；0=只做静态核对（doc 34 §1.3 第一版口径）
SKILL_STUDIO_EXECUTE_PLUGIN=1
# 团队记忆库（第二阶段；保持 0 与空值即完全离线，团队服务故障不影响本地）
TENCENT_MEMORY_ENABLED=0
TENCENT_MEMORY_API_BASE=
